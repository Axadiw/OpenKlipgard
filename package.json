{
  "name": "klipgard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bootstrap-admin": "node dist/scripts/bootstrap-admin.js",
    "reset-password": "node dist/scripts/reset-password.js",
    "edition": "node scripts/select-edition.mjs",
    "test": "STORY_REPORT_OUTPUT=test-results/vitest-server.json vitest run",
    "test:e2e": "playwright test --project=\"Desktop Chrome\" --project=\"Mobile Chrome\"",
    "test:e2e:smoke": "PRODUCTION_SMOKE=true playwright test --project=\"Production Smoke\"",
    "test:e2e:backend": "BACKEND_ONLY=1 playwright test --project=Backend --project=\"Backend exclusive\"",
    "test:report": "npx tsx scripts/build-test-report.ts",
    "test:all": "npm test; (cd frontend && npm test); (cd ftps-server && cargo nextest run --profile junit 2>/dev/null || cargo test); npm run test:e2e; npm run test:report",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/node": "^11.15.0",
    "@simplewebauthn/server": "^14.1.0",
    "bcrypt": "^6.0.0",
    "cbor-x": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^4.8.0",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.1.0",
    "resend": "^6.39.0",
    "stripe": "^23.2.0",
    "tslib": "^2.9.1"
  },
  "overrides": {
    "tar": ">=7.5.19",
    "undici": "^7.28.0",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.4",
    "brace-expansion": "^5.0.7",
    "hono": "^4.13.16",
    "@hono/node-server": "^2.1.6",
    "postcss": "^8.5.18",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@ts-safeql/eslint-plugin": "^5.4.4",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "libpg-query": "^18.2.4",
    "lint-staged": "^17.6.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
